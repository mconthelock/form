    "daisyui": "^5.0.9",
    "dotenv-webpack": "^8.1.0",
    "glob": "^13.0.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.12",
    "vitepress": "^2.0.0-alpha.12"
  },
  "dependencies": {
    "@amec/webasset": "git+https://github.com/sutthipongjab/webasset.git",
    "@fancyapps/ui": "^5.0.36",
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@fontsource/kanit": "^5.1.0",
    "@fontsource/roboto": "^5.1.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "crypto-js": "^4.2.0",
    "datatables.net-buttons": "^3.2.5",
    "datatables.net-buttons-dt": "^3.2.5",
    "datatables.net-dt": "^2.1.8",
    "datatables.net-responsive-dt": "^3.0.3",
    "datatables.net-select": "^3.0.1",
    "dayjs": "^1.11.19",
    "exceljs": "^4.4.0",
    "flatpickr": "^4.6.13",
    "jquery": "^3.7.1",
    "js-cookie": "^3.0.5",
    "jssha": "^3.3.1",
    "litepicker": "^2.0.12",
    "mime-types": "^3.0.1",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
