  "scripts": {
    "build:css": "tailwindcss -i ./assets/style/tailwind.css -o ./assets/dist/css/tailwind.css --minify",
    "build:js": "rspack build --mode production",
    "build": "run-s build:css build:js",
    "watch:css": "tailwindcss -i ./assets/style/tailwind.css -o ./assets/dist/css/tailwind.css --watch",
    "watch:js": "rspack build --watch --mode development",
    "watch": "run-s start-watch",
    "watch:update": "run-s update:webasset start-watch",
    "start-watch": "run-p watch:css watch:js",
    "update:webasset": "npm update @amec/webasset",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  }
}
